# ============================================================

ARQUIVO = "santa_casa.registros_medicos.json"

PASTA_SAIDA = "resultados_v36"

# MODOS:
# AUDITORIA -> Investiga estrutura e nomes
# COMPLETO  -> Investiga, valida e exporta CSVs

MODO = "COMPLETO"

MAX_PROFUNDIDADE = 6


# ============================================================
# 2. FUNCOES AUXILIARES
# ============================================================

def normalizar_texto(valor):

    if not isinstance(valor, str):
        return ""

    texto = unicodedata.normalize(
        "NFD",
        valor.upper()
    )

    texto = "".join(
        c for c in texto
        if unicodedata.category(c) != "Mn"
    )

    return re.sub(
        r"\s+", " ", texto
    ).strip()


def texto_seguro(valor):

    if valor is None:
        return ""

    if isinstance(valor, (dict, list, tuple)):
        return ""

    try:
        if pd.isna(valor):
            return ""
    except (TypeError, ValueError):
        return ""

    return str(valor).strip()


def identificador(valor):

    if isinstance(valor, dict):

        valor = valor.get(
            "$oid",
            valor.get("$numberLong")
        )

    if valor is None:
        return None

    try:
        if pd.isna(valor):
            return None
    except (TypeError, ValueError):
        return None

    if isinstance(valor, float) and valor.is_integer():
        valor = int(valor)

    resultado = str(valor).strip()

    return resultado if resultado else None


def carregar_banco():

    if not os.path.exists(ARQUIVO):

        raise FileNotFoundError(
            f"Arquivo nao encontrado: {ARQUIVO}"
        )

    print("\nCARREGANDO BANCO DE DADOS...")

    df = pd.read_json(ARQUIVO)

    print("BANCO CARREGADO COM SUCESSO")
    print(f"Pacientes: {len(df):,}")

    return df


def exportar_csv(tabela, nome):

    os.makedirs(
        PASTA_SAIDA,
        exist_ok=True
    )

    caminho = os.path.join(
        PASTA_SAIDA,
        nome
    )

    tabela.to_csv(
        caminho,
        index=False,
        encoding="utf-8-sig"
    )

    print(
        f"{nome}: {len(tabela):,} linhas"
    )


# ============================================================
# 3. TRATAMENTO DE DATAS
# ============================================================

def converter_data(valor):

    if isinstance(valor, dict):

        if "$date" in valor:
            return converter_data(valor["$date"])

        if "$numberLong" in valor:
            valor = valor["$numberLong"]

    if valor is None:
        return pd.NaT

    if isinstance(valor, str):

        valor = valor.strip()

        if valor.lower() in {
            "", "none", "null", "nan", "nat"
        }:
            return pd.NaT

        if re.fullmatch(r"\d{13}", valor):

            return pd.to_datetime(
                int(valor),
                unit="ms",
                utc=True,
                errors="coerce"
            )

        if re.fullmatch(r"\d{10}", valor):

            return pd.to_datetime(
                int(valor),
                unit="s",
                utc=True,
                errors="coerce"
            )

    try:

        return pd.to_datetime(
            valor,
            utc=True,
            errors="coerce"
        )

    except (
        TypeError,
        ValueError,
        OverflowError
    ):

        return pd.NaT


def converter_coluna_datas(serie):

    cache = {}
    resultado = []

    for valor in serie:

        try:
            chave = json.dumps(
                valor,
                sort_keys=True,
                default=str,
                ensure_ascii=False
            )
        except (TypeError, ValueError):
            chave = repr(valor)

        if chave not in cache:
            cache[chave] = converter_data(valor)

        resultado.append(cache[chave])

    return pd.to_datetime(
        pd.Series(
            resultado,
            index=serie.index
        ),
        utc=True,
        errors="coerce"
    )


# ============================================================
# 4. INVESTIGACAO DA ESTRUTURA DOS MEDICAMENTOS
# ============================================================

CONTAGEM_TIPOS = Counter()
CONTAGEM_CAMPOS = Counter()
CONTAGEM_CAMINHOS = Counter()


def investigar_estrutura(
    valor,
    caminho="medicamento",
    profundidade=0
):

    CONTAGEM_TIPOS[type(valor).__name__] += 1

    if profundidade > MAX_PROFUNDIDADE:
        return

    if isinstance(valor, dict):

        for chave, conteudo in valor.items():

            chave = str(chave)

            CONTAGEM_CAMPOS[chave] += 1

            novo_caminho = (
                f"{caminho}.{chave}"
            )

            CONTAGEM_CAMINHOS[
                novo_caminho
            ] += 1

            investigar_estrutura(
                conteudo,
                novo_caminho,
                profundidade + 1
            )

    elif isinstance(valor, (list, tuple)):

        for item in valor:

            investigar_estrutura(
                item,
                f"{caminho}[]",
                profundidade + 1
            )


# ============================================================
# 5. IDENTIFICACAO DOS CAMPOS DE NOME
# ============================================================

# Os nomes de campos abaixo sao candidatos.
# O programa nao presume que todos existam no JSON.

CAMPOS_NOME = {
    "nome",
    "nomemedicamento",
    "nomedoproduto",
    "nomemedicamento",
    "descricao",
    "descricaomedicamento",
    "descricaodomedicamento",
    "denominacao",
    "principioativo",
    "principioativomedicamento",
    "nomecomercial",
    "nomegenerico",
    "produto",
    "medicamento",
    "drugname",
    "name"
}

CAMPOS_CODIGO = {
    "codigo",
    "codigomedicamento",
    "id",
    "idmedicamento",
    "cod",
    "code"
}


def normalizar_chave(chave):

    texto = normalizar_texto(str(chave))

    return re.sub(
        r"[^A-Z0-9]",
        "",
        texto
    ).lower()


def nome_valido(texto):

    texto = texto_seguro(texto)

    if not texto:
        return False

    texto_normalizado = normalizar_texto(texto)

    if texto_normalizado in {
        "NAN",
        "NONE",
        "NULL",
        "NAT",
        "NAO INFORMADO",
        "NAO INFORMADA",
        "SEM INFORMACAO",
        "SEM DESCRICAO"
    }:
        return False

    # Evita tratar um identificador puramente
    # numerico como nome de medicamento.

    if re.fullmatch(
        r"[\d\s.,/-]+",
        texto
    ):
        return False

    # O nome deve conter pelo menos uma letra.

    if not re.search(
        r"[A-Za-zÀ-ÿ]",
        texto
    ):
        return False

    return True


def extrair_nome_medicamento(
    valor,
    profundidade=0
):

    """
    Retorna:
        (nome, origem)

    A funcao busca nomes em campos conhecidos,
    preservando a origem da extracao.

    Nao utiliza automaticamente campos
    desconhecidos como nomes.
    """

    if profundidade > MAX_PROFUNDIDADE:

        return (
            "NAO IDENTIFICADO",
            "LIMITE_PROFUNDIDADE"
        )

    # --------------------------------------------------------
    # Caso 1: texto simples
    # --------------------------------------------------------

    if isinstance(valor, str):

        if nome_valido(valor):

            return (
                valor.strip(),
                "TEXTO_DIRETO"
            )

        return (
            "NAO IDENTIFICADO",
            "TEXTO_INVALIDO"
        )

    # --------------------------------------------------------
    # Caso 2: dicionario
    # --------------------------------------------------------

    if isinstance(valor, dict):

        # Primeiro procura campos com nomes conhecidos.

        for chave, conteudo in valor.items():

            chave_normalizada = normalizar_chave(
                chave
            )

            if chave_normalizada not in CAMPOS_NOME:
                continue

            if isinstance(conteudo, str):

                if nome_valido(conteudo):

                    return (
                        conteudo.strip(),
                        f"CAMPO:{chave}"
                    )

            elif isinstance(
                conteudo,
                (dict, list, tuple)
            ):

                nome, origem = (
                    extrair_nome_medicamento(
                        conteudo,
                        profundidade + 1
                    )
                )

                if nome != "NAO IDENTIFICADO":

                    return (
                        nome,
                        f"{chave}.{origem}"
                    )

        # Depois procura estruturas aninhadas.

        for chave, conteudo in valor.items():

            if not isinstance(
                conteudo,
                (dict, list, tuple)
            ):
                continue

            nome, origem = (
                extrair_nome_medicamento(
                    conteudo,
                    profundidade + 1
                )
            )

            if nome != "NAO IDENTIFICADO":

                return (
                    nome,
                    f"{chave}.{origem}"
                )

        return (
            "NAO IDENTIFICADO",
            "DICIONARIO_SEM_NOME"
        )

    # --------------------------------------------------------
    # Caso 3: lista
    # --------------------------------------------------------

    if isinstance(valor, (list, tuple)):

        nomes = []

        for item in valor:

            nome, origem = (
                extrair_nome_medicamento(
                    item,
                    profundidade + 1
                )
            )

            if nome != "NAO IDENTIFICADO":

                if nome not in nomes:
                    nomes.append(nome)

        if nomes:

            return (
                " | ".join(nomes),
                "LISTA"
            )

        return (
            "NAO IDENTIFICADO",
            "LISTA_SEM_NOME"
        )

    # --------------------------------------------------------
    # Caso 4: numero, nulo ou outro tipo
    # --------------------------------------------------------

    return (
        "NAO IDENTIFICADO",
        f"TIPO:{type(valor).__name__}"
    )


# ============================================================
# 6. EXTRACAO DOS REGISTROS
# ============================================================

def extrair_registros(df):

    medicamentos = []
    chaves_atendimentos = set()

    print("\nEXTRAINDO REGISTROS...")

    for id_paciente, paciente in enumerate(
        df.itertuples(index=False)
    ):

        registros = getattr(
            paciente,
            "registros",
            []
        )

        if not isinstance(registros, list):
            continue

        for registro in registros:

            if not isinstance(registro, dict):
                continue

            tipo = registro.get("tipo")

            informacoes = registro.get(
                "informacoes",
                {}
            )

            if not isinstance(informacoes, dict):
                informacoes = {}

            atendimento_id = identificador(
                informacoes.get("atendimentoId")
            )

            chave = (
                id_paciente,
                atendimento_id
            )

            # Guarda as chaves de atendimento
            # apenas para validacao interna.

            if tipo == "ATENDIMENTO":

                if atendimento_id is not None:
                    chaves_atendimentos.add(chave)

                continue

            if tipo != "MEDICAMENTO":
                continue

            campo_medicamento = (
                informacoes.get("medicamento")
            )

            investigar_estrutura(
                campo_medicamento
            )

            nome, origem_nome = (
                extrair_nome_medicamento(
                    campo_medicamento
                )
            )

            medicamentos.append({

                "id_paciente_interno":
                    id_paciente,

                "id_normalizado":
                    atendimento_id,

                "medicamento":
                    nome,

                "origem_nome":
                    origem_nome,

                "tipo_estrutura":
                    type(
                        campo_medicamento
                    ).__name__,

                "via":
                    texto_seguro(
                        informacoes.get("via")
                    ),

                "dataAdministrada_original":
                    informacoes.get(
                        "dataAdministrada"
                    ),

                "dataEntrada_original":
                    registro.get(
                        "dataEntrada"
                    ),

                "dataCadastro_original":
                    registro.get(
                        "dataCadastro"
                    )
            })

    med = pd.DataFrame(medicamentos)

    print(
        f"Registros de medicamentos: {len(med):,}"
    )

    return med, chaves_atendimentos


# ============================================================
# 7. TRATAMENTO DOS CAMPOS
# ============================================================

def tratar_medicamentos(med):

    if med.empty:
        return med

    print("\nTRATANDO MEDICAMENTOS...")

    # Padroniza nomes para agregacao.

    med["medicamento"] = (
        med["medicamento"]
        .map(normalizar_texto)
    )

    med["medicamento"] = (
        med["medicamento"]
        .replace(
            "",
            "NAO IDENTIFICADO"
        )
    )

    med["via"] = (
        med["via"]
        .map(normalizar_texto)
        .replace(
            "",
            "NAO INFORMADA"
        )
    )

    # Converte as tres datas separadamente.

    for campo in (
        "dataAdministrada",
        "dataEntrada",
        "dataCadastro"
    ):

        med[campo] = converter_coluna_datas(
            med[f"{campo}_original"]
        )

    # Define a data de referencia.
    #
    # A prioridade continua:
    # 1. Administracao
    # 2. Entrada
    # 3. Cadastro

    med["data_referencia"] = (
        med["dataAdministrada"]
        .combine_first(
            med["dataEntrada"]
        )
        .combine_first(
            med["dataCadastro"]
        )
    )

    med["origem_data"] = "SEM DATA"

    med.loc[
        med["dataCadastro"].notna(),
        "origem_data"
    ] = "CADASTRO"

    med.loc[
        med["dataEntrada"].notna(),
        "origem_data"
    ] = "ENTRADA"

    med.loc[
        med["dataAdministrada"].notna(),
        "origem_data"
    ] = "ADMINISTRADA"

    med["ano_mes"] = (
        med["data_referencia"]
        .dt.tz_localize(None)
        .dt.to_period("M")
        .astype("string")
    )

    return med



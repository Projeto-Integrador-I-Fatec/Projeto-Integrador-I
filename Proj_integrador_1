# ============================================================
# 11. VALIDACAO DOS VINCULOS
# ============================================================

def validar_vinculos(
    med,
    chaves_atendimentos
):

    print("\n" + "=" * 55)
    print("VINCULOS MEDICAMENTOS / ATENDIMENTOS")
    print("=" * 55)

    vinculados = []

    for id_paciente, atendimento_id in zip(
        med["id_paciente_interno"],
        med["id_normalizado"]
    ):

        chave = (
            id_paciente,
            atendimento_id
        )

        vinculados.append(
            chave in chaves_atendimentos
        )

    med["vinculado_atendimento"] = (
        vinculados
    )

    total = len(med)

    validos = int(
        med["vinculado_atendimento"].sum()
    )

    print(f"Registros: {total:,}")
    print(f"Vinculados: {validos:,}")

    print(
        "Sem correspondencia: "
        f"{total - validos:,}"
    )

    return med


# ============================================================
# 12. EXPORTACAO DOS RESULTADOS
# ============================================================

def exportar_resultados(med):

    print("\n" + "=" * 55)
    print("EXPORTACAO DOS ARQUIVOS")
    print("=" * 55)

    # --------------------------------------------------------
    # 1. Frequencia dos medicamentos
    # --------------------------------------------------------

    frequencia = (
        med.groupby(
            "medicamento",
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
        .sort_values(
            "qtd_registros",
            ascending=False
        )
    )

    exportar_csv(
        frequencia,
        "frequencia_medicamentos.csv"
    )

    # --------------------------------------------------------
    # 2. Medicamentos por mes
    # --------------------------------------------------------

    por_mes = (
        med.groupby(
            [
                "ano_mes",
                "medicamento",
                "origem_data"
            ],
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
    )

    exportar_csv(
        por_mes,
        "medicamentos_por_mes.csv"
    )

    # --------------------------------------------------------
    # 3. Medicamentos por via
    # --------------------------------------------------------

    por_via = (
        med.groupby(
            "via",
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
        .sort_values(
            "qtd_registros",
            ascending=False
        )
    )

    exportar_csv(
        por_via,
        "medicamentos_por_via.csv"
    )

    # --------------------------------------------------------
    # 4. Qualidade dos nomes
    # --------------------------------------------------------

    qualidade_nomes = (
        med.groupby(
            [
                "tipo_estrutura",
                "origem_nome"
            ],
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
    )

    exportar_csv(
        qualidade_nomes,
        "qualidade_nomes_medicamentos.csv"
    )

    # --------------------------------------------------------
    # 5. Qualidade das datas
    # --------------------------------------------------------

    qualidade_datas = (
        med.groupby(
            "origem_data",
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
    )

    exportar_csv(
        qualidade_datas,
        "qualidade_datas_medicamentos.csv"
    )

    # --------------------------------------------------------
    # 6. Vias por mes
    # --------------------------------------------------------

    vias_mes = (
        med.groupby(
            [
                "ano_mes",
                "via",
                "origem_data"
            ],
            dropna=False
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
    )

    exportar_csv(
        vias_mes,
        "vias_por_mes.csv"
    )

    # --------------------------------------------------------
    # 7. VINCULOS
    # --------------------------------------------------------

    resumo_vinculos = (
        med.groupby(
            "vinculado_atendimento"
        )
        .size()
        .reset_index(
            name="qtd_registros"
        )
    )

    exportar_csv(
        resumo_vinculos,
        "qualidade_vinculos_medicamentos.csv"
    )

    # --------------------------------------------------------
    # 8. Estrutura dos campos
    # --------------------------------------------------------

    estrutura = pd.DataFrame(
        [
            {
                "campo": campo,
                "qtd_ocorrencias": quantidade
            }
            for campo, quantidade
            in CONTAGEM_CAMINHOS.items()
        ]
    )

    if not estrutura.empty:

        estrutura = estrutura.sort_values(
            "qtd_ocorrencias",
            ascending=False
        )

    exportar_csv(
        estrutura,
        "estrutura_medicamentos.csv"
    )

    print("\nEXPORTACAO CONCLUIDA")

    print(
        f"Pasta de resultados: {PASTA_SAIDA}"
    )

    print(
        "Somente tabelas agregadas foram exportadas."
    )

    print(
        "O JSON original nao foi alterado."
    )



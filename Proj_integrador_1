# 8. AUDITORIA DA ESTRUTURA
# ============================================================

def auditar_estrutura(med):

    print("\n" + "=" * 55)
    print("AUDITORIA DA ESTRUTURA DOS MEDICAMENTOS")
    print("=" * 55)

    print("\nTIPOS DO CAMPO MEDICAMENTO")

    print(
        med["tipo_estrutura"]
        .value_counts()
        .to_string()
    )

    print("\nCAMPOS INTERNOS MAIS FREQUENTES")

    for campo, quantidade in (
        CONTAGEM_CAMPOS.most_common(25)
    ):

        print(
            f"{campo}: {quantidade:,}"
        )

    print("\nCAMINHOS MAIS FREQUENTES")

    for caminho, quantidade in (
        CONTAGEM_CAMINHOS.most_common(25)
    ):

        print(
            f"{caminho}: {quantidade:,}"
        )

    print(
        "\nA auditoria mostra apenas nomes de "
        "campos e contagens, sem dados de pacientes."
    )


# ============================================================
# 9. AUDITORIA DOS NOMES
# ============================================================

def auditar_nomes(med):

    print("\n" + "=" * 55)
    print("QUALIDADE DOS NOMES DOS MEDICAMENTOS")
    print("=" * 55)

    total = len(med)

    identificados = int(
        med["medicamento"]
        .ne("NAO IDENTIFICADO")
        .sum()
    )

    nao_identificados = (
        total - identificados
    )

    percentual = (
        100 * identificados / total
        if total else 0
    )

    print(f"Total de registros: {total:,}")

    print(
        f"Com nome identificado: "
        f"{identificados:,}"
    )

    print(
        f"Sem nome identificado: "
        f"{nao_identificados:,}"
    )

    print(
        f"Taxa de identificacao: "
        f"{percentual:.2f}%"
    )

    print("\nORIGEM DOS NOMES EXTRAIDOS")

    print(
        med["origem_nome"]
        .value_counts()
        .head(20)
        .to_string()
    )

    print("\n15 NOMES MAIS FREQUENTES")

    frequencia = (
        med.loc[
            med["medicamento"]
            != "NAO IDENTIFICADO",
            "medicamento"
        ]
        .value_counts()
        .head(15)
    )

    if frequencia.empty:

        print(
            "Nenhum nome identificado."
        )

    else:

        print(
            frequencia.to_string()
        )

    print(
        "\nATENCAO: os nomes extraidos "
        "ainda precisam de validacao."
    )


